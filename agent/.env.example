# Copy to .env and fill in as needed. `.env` is gitignored — secrets stay local.

# Uncomment to talk to a remote/already-running minus-tracker-mcp instead of
# spawning one locally over stdio (the default). Part 19's --port has no
# fixed default, so MINUS_TRACKER_MCP_URL is required whenever transport=sse
# — there is no fallback value.
# MINUS_TRACKER_MCP_TRANSPORT=sse
# MINUS_TRACKER_MCP_URL=http://127.0.0.1:8080/mcp

# stdio only — override if `minus-tracker-mcp` isn't on PATH in this
# checkout (e.g. run the built TS entry point directly via node):
# MINUS_TRACKER_MCP_COMMAND=node
# MINUS_TRACKER_MCP_ARGS=../dist/mcp/index.js

# ADK's own model configuration (left at ADK's default otherwise):
# GOOGLE_API_KEY=
